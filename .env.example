# Mapfolio Environment Configuration Template
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Mapfolio
VITE_ENVIRONMENT=development

# Database Configuration (Optional - for saving posters/favorites)
VITE_DATABASE_URL=postgresql://user:password@localhost:5432/mapfolio

# Map Configuration (Optional - defaults to OpenFreeMap with zero tokens needed)
VITE_MAPLIBRE_ACCESS_TOKEN=
VITE_CESIUM_ION_ACCESS_TOKEN=
