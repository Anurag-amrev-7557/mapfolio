# Mapfolio AI Services Production Environment Variables
# Deploy to Render.com

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Database Configuration
DATABASE_URL=your_neon_database_url_here
REDIS_URL=redis://your-redis-url-here

# AI Model Configuration
MODEL_PATH=/app/models
CACHE_MODELS=true
GPU_ENABLED=false
NUM_WORKERS=2

# External API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Service Configuration
API_GATEWAY_URL=https://mapfolio-e4ym.onrender.com
FRONTEND_URL=https://mapfolio.pages.dev

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=your_sentry_dsn_here

# Security
JWT_SECRET_KEY=your_production_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
