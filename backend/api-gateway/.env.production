# Mapfolio API Gateway Production Environment Variables
# Deploy to Render.com

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# AI Services Configuration (Render external URLs)
AI_SERVICES_URL=https://mapfolio-ai-services.onrender.com

# Frontend Configuration (for CORS)
FRONTEND_URL=https://mapfolio.pages.dev

# Security
JWT_SECRET_KEY=your_production_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=your_sentry_dsn_here
